# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버(API route)에서만 사용, 절대 클라이언트 노출 금지

# === OpenAI ===
OPENAI_API_KEY=

# === Google APIs (Form 응답 감지, Sheets, Drive) ===
GOOGLE_CLIENT_EMAIL=                # 서비스 계정 이메일
GOOGLE_PRIVATE_KEY=                 # 서비스 계정 프라이빗 키 (개행은 \n 이스케이프)
GOOGLE_SHEET_ID=                    # 응답이 저장되는 스프레드시트 ID
GOOGLE_DRIVE_FOLDER_ID=             # 심층 PDF 저장 폴더 ID
GOOGLE_FORM_WEBHOOK_SECRET=         # Apps Script → /api/webhook/google-form 호출 시 검증용 시크릿

# === 사업자번호 조회 (국세청 사업자등록정보 진위확인 API 등) ===
BIZ_LOOKUP_API_KEY=

# === CRETOP (나이스디앤비 크레탑) ===
# 공식 API 계약이 있는 경우: 계약 시 발급받는 키 사용
CRETOP_API_KEY=
CRETOP_API_BASE_URL=
# 공식 API가 없어 로그인 세션 기반 자동화가 필요한 경우에만 사용.
# 이 두 값이 설정되고 CRETOP_API_KEY가 없으면 자동으로 "세션 자동화 모드"로 동작하며,
# scripts/cretop-worker.ts (별도 프로세스)가 실제 로그인/조회를 수행한다.
# ⚠️ 이 두 값은 lib/cretop-automation.ts 안에서만 읽힌다. 코드/Git/로그/DB 어디에도
#    직접 값을 넣지 말 것 — 반드시 .env.local(로컬) 또는 배포 플랫폼의 Secret 설정에만 둘 것.
CRETOP_ID=
CRETOP_PASSWORD=
# cretop-worker.ts가 조회 완료 후 콜백을 보낼 배포된 Next.js 앱 주소.
# lib/agent.ts도 관리자 알림 링크를 만들 때 이 값을 사용한다.
SITE_URL=https://your-site.netlify.app

# === 관리자 알림 (신규 접수 / 결과 완료 시 발송) ===
# slack | discord | telegram | sms | kakao 중 하나. 비워두면 알림을 보내지 않는다.
NOTIFICATION_PROVIDER=
# slack 선택 시
SLACK_WEBHOOK_URL=
# discord 선택 시
DISCORD_WEBHOOK_URL=
# telegram 선택 시
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# sms / kakao 선택 시 (둘 다 실제 발송사 연동 필요 — lib/notifications/providers 의 TODO 참고)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER=
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_SENDER_KEY=
KAKAO_ALIMTALK_TEMPLATE_CODE=
ADMIN_NOTIFICATION_PHONE=

# === 문자(SMS) 인증 (심층 건강검진 STEP9 휴대폰 인증 — 위 관리자 알림용 SMS와는 별개) ===
SMS_OTP_PROVIDER_API_KEY=
SMS_OTP_PROVIDER_SENDER=

# === 관리자 페이지 접근 ===
ADMIN_ACCESS_KEY=                   # 임시 보호용, 추후 Supabase Auth로 교체 권장

# === 2차 정밀진단 - 세무법인 (v11) ===
# ⚠️ 이 프로젝트 코드베이스 어디에도 기존에 설정된 세무법인 상담 URL이 없었다.
# "이미 설정되어 있는 URL로 연결"이 요청되었으나 실제로는 존재하지 않아 임의로 만들지 않았다 —
# 아래 값을 채우면 2차 정밀진단 화면의 "세무법인 정밀진단 받기" 버튼이 그 주소로 연결된다.
# 비워두면 버튼이 "준비중"으로 비활성 표시된다. (민감정보 아님 — 브라우저에 그대로 노출되는
# NEXT_PUBLIC_ 값으로 둬도 안전한 단순 링크 주소다)
NEXT_PUBLIC_TAX_FIRM_CONSULT_URL=
