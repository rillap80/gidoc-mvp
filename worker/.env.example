# 크레탑 자동화 워커 전용 환경변수.
# 이 워커는 Vercel(메인 Next.js 앱)과 별도로 상시구동 호스트(Railway/Render/VPS 등)에 배포한다.

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ⚠️ 절대 코드/Git/로그/DB에 직접 값을 넣지 말 것. 이 두 값은 ../lib/cretop-automation.ts에서만 읽는다.
CRETOP_ID=
CRETOP_PASSWORD=

# 메인 Next.js 앱(Vercel)의 배포 주소 — 조회 완료 후 이 주소의 /api/agent/continue 를 호출한다.
SITE_URL=https://your-app.vercel.app

# app/api/agent/continue 인증에 사용하는 값 — Vercel 쪽 GOOGLE_FORM_WEBHOOK_SECRET과 동일해야 한다.
GOOGLE_FORM_WEBHOOK_SECRET=
